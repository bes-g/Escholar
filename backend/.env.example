# Gemini free tier, through the OpenAI-compatible endpoint.
# Create a key in Google AI Studio and keep it only on the server.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Use "low" for Gemini. Leave empty for providers that reject this field.
LLM_REASONING_EFFORT=low

# Optional. Local runs use SQLite when this is empty.
# Neon example (the app rewrites postgresql:// to the psycopg driver):
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

MAX_TOOL_CALLS=8
# FRONTEND_DIST=../frontend/dist

# Created on startup when both are set. Signup always creates a student.
# A Firebase account with this email is an administrator. Other signups stay students.
# ADMIN_EMAIL=admin@escholar.local
# ADMIN_PASSWORD=

# Firebase Authentication. Leave empty to keep the local demo sign-in.
# When FIREBASE_PROJECT_ID is set, the browser must use the same project in frontend/.env.
# FIREBASE_PROJECT_ID=
# Optional. Used only to read project_id when FIREBASE_PROJECT_ID is empty. Do not commit this file.
# FIREBASE_SERVICE_ACCOUNT_FILE=

# Optional. Embeddings are always stored locally. A copy is upserted when both are set.
# PINECONE_API_KEY=
# PINECONE_INDEX=escholar

# Optional. Matches are saved on the student dashboard even when mail is not configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
