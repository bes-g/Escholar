# Gemini free tier, through the OpenAI-compatible endpoint.
# Create a key in Google AI Studio and keep it only on the server.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Use "low" for Gemini. Leave empty for providers that reject this field.
LLM_REASONING_EFFORT=low

# Optional. Local runs use SQLite when this is empty.
# Neon example (the app rewrites postgresql:// to the psycopg driver):
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

MAX_TOOL_CALLS=8
# FRONTEND_DIST=../frontend/dist
